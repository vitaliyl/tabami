{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Tabami",
  "version": "0.1.0",
  "identifier": "com.tabami.studio",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tabami - Database Studio",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Modern database studio for SQLite, PostgreSQL, and MySQL",
    "longDescription": "Tabami is a fast, lightweight, and modern database studio for SQLite, PostgreSQL, and MySQL, built with Hanami 3.0, Inertia.js, Vue 3, and Tauri 2.0.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
