{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["app/assets/js/*"]
    }
  },
  "include": [
    "app/assets/js/**/*.ts",
    "app/assets/js/**/*.d.ts",
    "app/assets/js/**/*.tsx",
    "app/assets/js/**/*.vue"
  ]
}
